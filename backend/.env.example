# PostgreSQL connection string used by SQLAlchemy asyncpg.
# Create this database before running ./setup.sh if your PostgreSQL user
# cannot create databases automatically.
DATABASE_URL=postgresql+asyncpg://org_user:replace-with-a-strong-password@localhost:5432/organization_lms

# JWT signing secret. Generate a local value with:
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-value
